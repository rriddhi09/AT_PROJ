NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/unified_interview
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_INVITE_SECRET=replace-with-a-third-long-random-invite-secret
JWT_ACCESS_TTL=15m
JWT_INVITE_TTL=7d
HOST_ABSENCE_GRACE_SECONDS=300
JWT_REFRESH_TTL_DAYS=7
GOOGLE_CLIENT_ID=
COOKIE_SECURE=false
MONGODB_USE_TRANSACTIONS=false
# Self-hosted Piston sandbox. No token is needed for the local Docker setup.
CODE_EXECUTION_URL=http://127.0.0.1:2000/api/v2/execute
CODE_EXECUTION_TOKEN=
# Production: configure HTTPS and a TURN service. Do not commit real secrets.
# Client Vite environment: VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=generated-per-session-user
# VITE_TURN_CREDENTIAL=generated-per-session-credential
